# Puerto del servidor HTTP (por defecto 3000)
PORT=3000

# Intervalo del Cron en milisegundos (por defecto 60000 ms = 1 minuto). Mínimo 5000.
CRON_INTERVAL_MS=60000

# Cantidad de ofertas a solicitar a Binance P2P (1-100). Si supera 20, se pagina.
OFFERS_ROWS=20

# Filtro de bancos / métodos de pago (identificadores payTypes de Binance, separados por coma).
# Vacío = todos. Ejemplo: Banesco,PagoMovil,Mercantil
PAY_TYPES=

# Horas de retención del historial JSONL. 0 = no depurar.
RETENTION_HOURS=48

# Ruta del archivo de historial (relativa al cwd o absoluta)
DATA_FILE=data/advertising_history.jsonl

# Archivo JSON con la configuración persistida desde la UI (sobrescribe estos defaults)
SETTINGS_FILE=data/app-settings.json
